<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist on the Mac: where Sparkle finds
	     updates, and the public half of the key they're signed with
	     (project.yml, scripts/make-appcast.sh). Empty, as from source, the
	     app doesn't check (App/macOS/Updates.swift). -->
	<key>SUFeedURL</key>
	<string>$(SPARKLE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(SPARKLE_PUBLIC_ED_KEY)</string>
	<!-- In the sandbox an update is installed by Sparkle's installer
	     launcher, an XPC service (Spectre.entitlements). -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
</dict>
</plist>
