<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- QUIC to the lobby and session hosts. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The microphone, sent to the host while the user has it on (sandbox and hardened runtime). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Files the user picks with Send Files… to send to the host (dropped ones need nothing). -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- The prototype's loopback QUIC self-test listens on 127.0.0.1. -->
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
