{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre verbindet sich mit ghost-Hosts und -Servern in deinem lokalen Netzwerk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Spectre connects to ghost hosts and servers on your local network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre se conecta a hosts y servidores ghost de tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre se connecte aux hôtes et serveurs ghost de votre réseau local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre はローカルネットワーク上の ghost ホストやサーバに接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre는 로컬 네트워크에 있는 ghost 호스트 및 서버에 연결합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Spectre se conecta a hosts e servidores ghost na sua rede local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre подключается к хостам и серверам ghost в вашей локальной сети."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre 会连接你本地网络中的 ghost 主机和服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre 會連線到你區域網路中的 ghost 主機和伺服器。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre hört zu, während du die Mikrofontaste gedrückt hältst oder antippst, und gibt das Gesagte auf dem Remote-Desktop ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Spectre listens while you hold or tap the microphone key, and types what you say on the remote desktop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre escucha mientras mantienes pulsada o tocas la tecla del micrófono, y escribe lo que dices en el escritorio remoto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre écoute pendant que vous maintenez ou touchez la touche micro, et saisit ce que vous dites sur le bureau à distance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクキーを押している間やタップしたあと、Spectre はあなたの声を聞き取り、話した内容をリモートデスクトップに入力します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크 키를 길게 누르거나 탭하면 Spectre가 사용자의 말을 듣고 원격 데스크탑에 입력합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Spectre ouve enquanto você mantém pressionada ou toca a tecla do microfone e digita o que você diz na área de trabalho remota."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre слушает, пока вы удерживаете клавишу микрофона или после ее касания, и вводит сказанное на удаленном рабочем столе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住或轻点麦克风键时，Spectre 会听你说话，并把你说的内容输入到远程桌面上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住或輕點麥克風鍵時，Spectre 會聽你說話，並把你說的內容輸入到遠端桌面上。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
