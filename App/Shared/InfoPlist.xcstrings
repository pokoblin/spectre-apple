  "strings" : {
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Spectre connects to ghost hosts and servers on your local network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre se conecta a hosts y servidores ghost de tu red local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre はローカルネットワーク上の ghost ホストやサーバに接続します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre 会连接你本地网络中的 ghost 主机和服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre 會連線到你區域網路中的 ghost 主機和伺服器。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Spectre sends your microphone to the remote desktop while you have it turned on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre envía tu micrófono al escritorio remoto mientras lo tienes activado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクをオンにしている間、Spectre はマイクの音声をリモートデスクトップに送信します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre 会在你打开麦克风时，把麦克风的声音发送到远程桌面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre 會在你開啟麥克風時，將麥克風的聲音傳送到遠端桌面。"
          }
        }
      }
    }
