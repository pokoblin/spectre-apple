    "Add the server with +, then tap Connect and sign in with your account on it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge den Server mit + hinzu, tippe dann auf „Verbinden“ und melde dich mit deinem Konto darauf an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el servidor con + y toca Conectar para iniciar sesión con tu cuenta en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez le serveur avec +, puis touchez Connecter et identifiez-vous avec votre compte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "＋ でサーバーを追加し、「接続」をタップして、サーバー上のアカウントでサインインします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+로 서버를 추가한 다음 ‘연결’을 탭하고 서버의 계정으로 로그인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione o servidor com + e toque em Conectar para iniciar sessão com sua conta nele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте сервер кнопкой +, затем коснитесь «Подключиться» и войдите со своей учетной записью на нем."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 + 添加服务器，然后点「连接」，用你在服务器上的账户登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 + 新增伺服器，然後點「連線」，用你在伺服器上的帳號登入。"
          }
        }
