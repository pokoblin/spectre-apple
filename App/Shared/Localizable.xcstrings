    "Listening. Release to send, slide away to cancel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hört zu. Zum Senden loslassen, zum Abbrechen wegschieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escuchando. Suelta para enviar, desliza fuera para cancelar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoute en cours. Relâchez pour envoyer, glissez ailleurs pour annuler."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聞き取っています。指を離すと送信、横にずらすとキャンセル。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "듣는 중. 손을 떼면 보내고, 밀어서 벗어나면 취소합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvindo. Solte para enviar, deslize para longe para cancelar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слушаю. Отпустите, чтобы отправить, или отведите палец, чтобы отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在听。松手发送，滑开取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在聽。放開即傳送，滑開即取消。"
          }
        }
      }
    },
