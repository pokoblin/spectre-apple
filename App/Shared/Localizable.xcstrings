          "stringUnit" : {
            "state" : "translated",
            "value" : "監看的區域停止變化了。"
          }
        }
      }
    },
    "There are too many files in it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält zu viele Dateien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contiene demasiados archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il contient trop de fichiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "含まれるファイルが多すぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 안에 파일이 너무 많습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela contém arquivos demais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В ней слишком много файлов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中的文件太多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中的檔案太多。"
          }
        }
      }
    },
    "These are the defaults for new sessions. A change here applies to open sessions too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies sind die Standardwerte für neue Sitzungen. Eine Änderung hier gilt auch für offene Sitzungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son los valores predeterminados de las sesiones nuevas. Un cambio aquí también se aplica a las sesiones abiertas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce sont les valeurs par défaut des nouvelles sessions. Une modification ici s’applique aussi aux sessions ouvertes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいセッションのデフォルトです。ここでの変更は開いているセッションにも適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 세션의 기본값입니다. 여기서 변경하면 열려 있는 세션에도 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes são os padrões para novas sessões. Uma alteração aqui também se aplica às sessões abertas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это значения по умолчанию для новых сеансов. Изменения здесь применяются и к открытым сеансам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些是新会话的默认设置。在这里所做的更改也会应用到已打开的会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些是新工作階段的預設設定。在這裡所做的更改也會套用到已開啟的工作階段。"
          }
        }
      }
    },
    "Third-Party Notices" : {
      "localizations" : {
