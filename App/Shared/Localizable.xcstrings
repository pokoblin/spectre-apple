        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captura el ratón para juegos y vistas 3D: movimiento relativo y puntero bloqueado (Ctrl+Cmd+G)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
