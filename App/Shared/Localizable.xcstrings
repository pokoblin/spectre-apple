    "Nothing has been sent to the server yet. If you trust it, Spectre remembers this fingerprint and warns you if it ever changes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An den Server wurde noch nichts gesendet. Wenn du ihm vertraust, merkt sich Spectre diesen Fingerabdruck und warnt dich, falls er sich jemals ändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no se ha enviado nada al servidor. Si confías en él, Spectre recordará esta huella y te avisará si alguna vez cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’a encore été envoyé au serveur. Si vous lui faites confiance, Spectre mémorise cette empreinte et vous avertit si elle change un jour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだサーバーには何も送信していません。信頼すると、Spectre はこのフィンガープリントを記憶し、変わったときに警告します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 서버에 아무것도 보내지 않았습니다. 신뢰하면 Spectre가 이 지문을 기억하고, 지문이 바뀌면 경고합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada foi enviado ao servidor ainda. Se você confiar nele, o Spectre se lembrará desta impressão digital e avisará você se ela mudar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На сервер пока ничего не отправлено. Если вы ему доверяете, Spectre запомнит этот отпечаток и предупредит вас, если он когда-либо изменится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有向服务器发送任何内容。如果你信任它，Spectre 会记住这个指纹，并在它变化时提醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未向伺服器傳送任何內容。如果你信任它，Spectre 會記住這個指紋，並在它變更時提醒你。"
          }
        }
      }
    },
