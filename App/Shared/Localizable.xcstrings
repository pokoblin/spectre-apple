    "Sent to the host's clipboard" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado al portapapeles del host"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
