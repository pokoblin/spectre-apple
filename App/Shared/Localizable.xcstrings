    "Presented now" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本次出示的"
          }
        }
      }
    },
    "Recent" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近"
          }
        }
      }
    },
    "Reconnecting… (attempt %lld of %lld)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reconnecting… (attempt %1$lld of %2$lld)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在重新连接…（第 %lld 次，共 %lld 次）"
          }
        }
      }
    },
    "Remember" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记住"
          }
        }
      }
    },
    "Saved" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的"
          }
        }
      }
    },
    "Send Copies Automatically" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动发送拷贝的内容"
          }
        }
      }
    },
    "Send this device's clipboard to the remote desktop" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把这台设备的剪贴板发送到远程桌面"
          }
        }
      }
    },
    "Send your microphone to the remote desktop (use headphones, or it hears its own sound)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你的麦克风发送到远程桌面（请戴耳机，否则它会听到自己的声音）"
          }
        }
      }
    },
    "Server" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器"
          }
        }
      }
    },
    "Session running" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话运行中"
          }
        }
      }
    },
    "Share Clipboard" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享剪贴板"
          }
        }
      }
    },
    "Share the clipboard with the remote desktop: text copied on either side can be pasted on the other" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与远程桌面共享剪贴板：在任一端拷贝的文字都可以在另一端粘贴"
          }
        }
      }
    },
    "Someone else is viewing this session. Sign in again and choose to take it over." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他人正在查看这个会话。请重新登录并选择接管。"
          }
        }
      }
    },
    "Someone is viewing it from another device. Taking over disconnects them; the session keeps running." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人正在从另一台设备查看它。接管会断开对方的连接，会话继续运行。"
          }
        }
      }
    },
    "Spectre hasn't seen this server before. Check that its certificate fingerprint matches the one its administrator gave you before you sign in." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre 之前没有连接过这个服务器。登录前，请确认它的证书指纹与管理员给你的一致。"
          }
        }
      }
    },
    "Spectre isn't allowed to use the microphone. Turn it on in System Settings → Privacy & Security → Microphone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre 没有使用麦克风的权限。请在“系统设置”→“隐私与安全性”→“麦克风”中打开。"
          }
        }
      }
    },
    "Start" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始"
          }
        }
      }
    },
    "Statistics" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "统计"
          }
        }
      }
    },
    "Stop sending your microphone" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止发送麦克风"
          }
        }
      }
    },
    "Take over from the other viewer" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从另一位查看者那里接管"
          }
        }
      }
    },
    "The app was in the background." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 曾在后台。"
          }
        }
      }
    },
    "The certificate of %@ has changed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的证书已更改"
          }
        }
      }
    },
    "The connection was lost and could not be restored." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接已丢失，且无法恢复。"
          }
        }
      }
    },
    "The connection was lost. Sign in again to continue." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接已丢失。请重新登录以继续。"
          }
        }
      }
    },
    "The connection was lost. Sign in again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接已丢失。请重新登录。"
          }
        }
      }
    },
    "The demo could not start: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "演示无法启动：%@"
          }
        }
      }
    },
    "The host can't send any video format this device decodes." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机无法发送这台设备能解码的任何视频格式。"
          }
        }
      }
    },
    "The microphone didn't start: %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风没有启动：%@。"
          }
        }
      }
    },
    "The next connection to %@ will ask you to verify its new fingerprint." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次连接到 %@ 时，会请你核对它的新指纹。"
          }
        }
      }
    },
    "The server did not answer." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器没有响应。"
          }
        }
      }
    },
    "The session ended." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话已结束。"
          }
        }
      }
    },
    "The session ended: %@ (code %lld)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The session ended: %1$@ (code %2$lld)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话已结束：%@（代码 %lld）。"
          }
        }
      }
    },
    "The session host presented a different certificate than the login promised." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话主机出示的证书与登录时告知的不一致。"
          }
        }
      }
    },
    "The session refused the login token. Sign in again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话拒绝了登录令牌。请重新登录。"
          }
        }
      }
    },
    "This can mean someone is intercepting the connection. Spectre did not send your username. Unless the server's administrator told you its certificate was replaced, don't continue." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这可能意味着有人在拦截连接。Spectre 没有发送你的用户名。除非服务器管理员告诉过你证书已更换，否则不要继续。"
          }
        }
      }
    },
    "This ends the desktop session itself, not just this connection." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会结束桌面会话本身，而不只是断开这个连接。"
          }
        }
      }
    },
    "Touch" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触摸"
          }
        }
