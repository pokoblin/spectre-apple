          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Четче на дисплеях Retina, но нагрузка на хост до четырех раз выше"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Retina 屏幕上更清晰，主机的工作量最多为四倍"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Retina 螢幕上更清晰，主機的工作量最多為四倍"
          }
        }
      }
    },
    "Sharper video over a wired network of 1 Gbit/s or more, at hundreds of Mbit/s" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
