    },
    "%lld characters can't be typed on the host's US layout. Use the host's input method for other scripts." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld character can't be typed on the host's US layout. Use the host's input method for other scripts."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "new",
                  "value" : "%lld characters can't be typed on the host's US layout. Use the host's input method for other scripts."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld carácter no se puede escribir con la distribución estadounidense del host. Para otras escrituras, usa el método de entrada del host."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld caracteres no se pueden escribir con la distribución estadounidense del host. Para otras escrituras, usa el método de entrada del host."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 文字はホストの US 配列では入力できません。ほかの文字はホストの入力メソッドを使ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 个字符无法在主机的美式键盘布局上输入。其他文字请使用主机的输入法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 個字元無法在主機的美式鍵盤配置上輸入。其他文字請使用主機的輸入法。"
          }
        }
      }
    },
    "A %@ session is running; you'll return to it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una sesión de %@ en curso; volverás a ella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のセッションが実行中です。そのセッションに戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一个 %@ 会话正在运行，你将回到这个会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一個 %@ 工作階段正在執行，你將回到這個工作階段。"
          }
        }
      }
    },
