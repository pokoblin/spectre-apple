    "Gamepads (%lld)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手柄（%lld）"
          }
        }
      }
    },
    "Keep this in the Keychain and sign in with one tap next time. Leave one-time codes unticked." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存到钥匙串，下次点一下即可登录。一次性验证码不要勾选。"
          }
        }
      }
    },
    "Keyboard" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "键盘"
          }
        }
      }
    },
    "Leave the session running and disconnect" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "断开连接，会话继续运行"
