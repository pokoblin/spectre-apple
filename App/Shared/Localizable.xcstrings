          "stringUnit" : {
            "state" : "translated",
            "value" : "麥克風沒有啟動：%@。"
          }
        }
      }
    },
    "The next connection to %@ will ask you to verify its new fingerprint." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回 %@ に接続するときに、新しいフィンガープリントの確認を求められます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次连接到 %@ 时，会请你核对它的新指纹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次連線到 %@ 時，會請你核對它的新指紋。"
          }
        }
      }
    },
    "The server did not answer." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーが応答しませんでした。"
          }
