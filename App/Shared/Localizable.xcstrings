    "The default port is %@. To connect from outside your network, use a VPN such as Tailscale rather than exposing the port to the internet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standardport ist %@. Um dich von außerhalb deines Netzwerks zu verbinden, verwende ein VPN wie Tailscale, statt den Port im Internet freizugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El puerto predeterminado es %@. Para conectarte desde fuera de tu red, usa una VPN como Tailscale en lugar de exponer el puerto a internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le port par défaut est %@. Pour vous connecter depuis l’extérieur de votre réseau, utilisez un VPN comme Tailscale plutôt que d’exposer le port à Internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトのポートは %@ です。外部のネットワークから接続するときは、ポートをインターネットに公開せず、Tailscale などの VPN を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 포트는 %@입니다. 네트워크 외부에서 연결하려면 포트를 인터넷에 노출하지 말고 Tailscale 같은 VPN을 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A porta padrão é %@. Para se conectar de fora da sua rede, use uma VPN como a Tailscale em vez de expor a porta à internet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порт по умолчанию — %@. Для подключения извне вашей сети используйте VPN, например Tailscale, а не открывайте порт в интернет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认端口是 %@。要从外网连接，请使用 Tailscale 等 VPN，不要把端口直接暴露到公网。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設埠為 %@。要從外部網路連線，請使用 Tailscale 等 VPN，不要把埠直接暴露在網際網路上。"
          }
        }
      }
    },
