    "Use the password of %@ on this server. If the server asks for more, such as a one-time code, it comes next." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende das Passwort von %@ auf diesem Server. Wenn der Server mehr verlangt, etwa einen Einmalcode, wird das als Nächstes abgefragt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la contraseña de %@ en este servidor. Si el servidor pide algo más, como un código de un solo uso, se pedirá a continuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le mot de passe de %@ sur ce serveur. Si le serveur demande autre chose, comme un code à usage unique, cela vous sera demandé ensuite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーでの %@ のパスワードを使います。ワンタイムコードなど、ほかにも必要なものがあれば次に尋ねられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서버에서 사용하는 %@의 암호를 입력하세요. 서버가 일회용 코드 같은 추가 정보를 요청하면 다음 단계에서 묻습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a senha de %@ neste servidor. Se o servidor pedir mais, como um código de uso único, isso será pedido em seguida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте пароль %@ на этом сервере. Если сервер запросит что-то еще, например одноразовый код, это будет следующим шагом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 %@ 在这台服务器上的密码。如果服务器还要别的（比如一次性验证码），会在下一步询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 %@ 在這台伺服器上的密碼。如果伺服器還要別的（例如一次性驗證碼），會在下一步詢問。"
          }
        }
      }
    },
