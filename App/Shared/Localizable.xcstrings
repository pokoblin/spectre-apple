      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风"
          }
        }
      }
    },
    "Mute" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静音"
          }
        }
      }
    },
    "Mute the remote desktop's sound on this device" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这台设备上将远程桌面静音"
          }
        }
      }
    },
    "No hosts are assigned to you." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有分配给你的主机。"
          }
        }
      }
    },
    "Nothing has been sent to the server yet. If you trust it, Spectre remembers this fingerprint and warns you if it ever changes." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有向服务器发送任何内容。如果你信任它，Spectre 会记住这个指纹，并在它变化时提醒你。"
          }
        }
      }
    },
    "OK" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好"
          }
        }
      }
    },
    "Offline" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离线"
          }
        }
      }
    },
    "Online" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在线"
          }
        }
      }
    },
    "Opening the session…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在打开会话…"
          }
        }
      }
    },
    "Play the remote desktop's sound" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放远程桌面的声音"
