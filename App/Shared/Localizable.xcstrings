          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームや 3D ビュー向けにマウスをキャプチャします：相対移動を送り、ポインタをロックします（Ctrl+Cmd+G）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 및 3D 화면용으로 마우스를 캡처합니다. 상대 움직임을 보내고 포인터를 고정합니다(Ctrl+Cmd+G)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
