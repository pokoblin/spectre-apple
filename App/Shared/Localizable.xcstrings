    "Every other key goes to the remote desktop, Cmd as Super. ⌘Q quits Spectre, as in every app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle anderen Tasten gehen an den Remote-Desktop, Cmd als Super. ⌘Q beendet Spectre wie in jeder App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las demás teclas van al escritorio remoto, Cmd como Super. ⌘Q cierra Spectre, como en cualquier app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les autres touches vont au bureau à distance, Cmd faisant office de Super. ⌘Q quitte Spectre, comme dans toute app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのキーはすべてリモートデスクトップに送られます。Cmd は Super として送られます。⌘Q はほかのアプリと同じく Spectre を終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 밖의 모든 키는 원격 데스크탑으로 전송되며, Cmd는 Super로 전송됩니다. ⌘Q는 다른 앱과 마찬가지로 Spectre를 종료합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As demais teclas vão para a área de trabalho remota, Cmd como Super. ⌘Q encerra o Spectre, como em qualquer app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все остальные клавиши передаются на удаленный рабочий стол, Cmd — как Super. ⌘Q завершает Spectre, как в любом приложении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他按键都发送给远程桌面，Cmd 作为 Super 键。⌘Q 和其他 App 一样退出 Spectre。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他按鍵都傳送給遠端桌面，Cmd 作為 Super 鍵。⌘Q 和其他 App 一樣結束 Spectre。"
          }
        }
      }
    },
    "Exact text and lines on a still screen, at more work for the host" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exakter Text und exakte Linien bei ruhendem Bild, mit mehr Aufwand für den Host"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto y líneas exactos cuando la pantalla está quieta, a costa de más trabajo para el host"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte et lignes exacts sur un écran immobile, au prix de plus de travail pour l’hôte"
          }
