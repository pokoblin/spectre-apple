    "Add the server with +, then tap Connect and sign in with your account on it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el servidor con + y toca Conectar para iniciar sesión con tu cuenta en él."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "＋ でサーバーを追加し、「接続」をタップして、サーバー上のアカウントでサインインします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
