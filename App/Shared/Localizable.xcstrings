{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "shouldTranslate" : false
    },
    "%lld characters can't be typed on the host's US layout. Use the host's input method for other scripts." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld character can't be typed on the host's US layout. Use the host's input method for other scripts."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "new",
                  "value" : "%lld characters can't be typed on the host's US layout. Use the host's input method for other scripts."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 个字符无法在主机的美式键盘布局上输入。其他文字请使用主机的输入法。"
          }
        }
      }
    },
    "A %@ session is running; you'll return to it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一个 %@ 会话正在运行，你将回到这个会话。"
          }
        }
      }
    },
    "Another client took this session over." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个客户端接管了这个会话。"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消"
          }
        }
      }
    },
    "Capture Mouse" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "捕获鼠标"
          }
        }
      }
    },
    "Capture the mouse for games and 3D views: relative motion, the pointer locked (Ctrl+Cmd+G)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为游戏和 3D 视图捕获鼠标：发送相对移动，锁定指针（Ctrl+Cmd+G）"
          }
        }
      }
    },
    "Choose a desktop" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
