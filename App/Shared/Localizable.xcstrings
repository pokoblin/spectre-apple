    "Share the clipboard with the remote desktop: text copied on either side can be pasted on the other" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwischenablage mit dem Remote-Desktop teilen: Auf einer Seite kopierter Text kann auf der anderen eingesetzt werden"
          }
        },
        "es" : {
          "stringUnit" : {
