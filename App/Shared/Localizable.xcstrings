    "Drag to frame the region to watch. Leave out the terminal's input line, where the cursor blinks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe, um den zu beobachtenden Bereich einzurahmen. Lass die Eingabezeile des Terminals aus, in der der Cursor blinkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para enmarcar la región que quieres vigilar. Deja fuera la línea de entrada del terminal, donde parpadea el cursor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour encadrer la zone à surveiller. Laissez de côté la ligne de saisie du terminal, où clignote le curseur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして監視する範囲を囲みます。ターミナルでカーソルが点滅している入力行は含めないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 감시할 영역을 지정하세요. 커서가 깜박이는 터미널의 입력 줄은 제외하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para enquadrar a região a observar. Deixe de fora a linha de entrada do terminal, onde o cursor pisca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетяните, чтобы выделить область для отслеживания. Не включайте строку ввода терминала, где мигает курсор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动框出要监视的区域，不要包含终端里闪烁光标所在的输入行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖曳框出要監看的區域，不要包含終端機裡閃爍游標所在的輸入列。"
          }
        }
      }
    },
    "Drop to send to the remote desktop" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loslassen, um an den Remote-Desktop zu senden"
