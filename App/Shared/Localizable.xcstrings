    "Sharper on Retina screens, at up to four times the work for the host" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schärfer auf Retina-Bildschirmen, mit bis zu viermal so viel Aufwand für den Host"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más nítido en pantallas Retina, con hasta cuatro veces más trabajo para el host"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus net sur les écrans Retina, avec jusqu’à quatre fois plus de travail pour l’hôte"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retina ディスプレイでより鮮明になりますが、ホストの負荷は最大 4 倍になります"
          }
