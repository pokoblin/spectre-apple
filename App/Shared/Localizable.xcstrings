    "Capture the mouse for games and 3D views: relative motion, the pointer locked (Ctrl+Cmd+G)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲームや 3D ビュー向けにマウスをキャプチャします：相対移動を送り、ポインタをロックします（Ctrl+Cmd+G）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
