    "Make sure this device can reach it: the same network, or the same VPN, such as Tailscale." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle sicher, dass dieses Gerät ihn erreichen kann: im selben Netzwerk oder im selben VPN, etwa Tailscale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que este dispositivo pueda llegar a él: en la misma red o en la misma VPN, como Tailscale."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que cet appareil peut l’atteindre : même réseau, ou même VPN, comme Tailscale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスから接続できることを確認してください：同じネットワーク、または Tailscale などの同じ VPN 上にあること。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 서버에 연결할 수 있는지 확인하세요. 같은 네트워크에 있거나 Tailscale 같은 동일한 VPN에 연결되어 있어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se este dispositivo consegue alcançá-lo: na mesma rede ou na mesma VPN, como a Tailscale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что это устройство может к нему подключиться: та же сеть или та же VPN, например Tailscale."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确保这台设备能连到它：在同一网络，或同一个 VPN（如 Tailscale）里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確保這台裝置能連到它：在同一網路，或同一個 VPN（如 Tailscale）裡。"
          }
        }
      }
    },
