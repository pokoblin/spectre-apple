    "Make sure this device can reach it: the same network, or the same VPN, such as Tailscale." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que este dispositivo pueda llegar a él: en la misma red o en la misma VPN, como Tailscale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスから接続できることを確認してください：同じネットワーク、または Tailscale などの同じ VPN 上にあること。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
