        }
      }
    },
    "Wrong username or password." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用户名或密码错误。"
          }
        }
      }
    },
    "You are logged in at the host itself. Log out there first." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已在主机本机登录。请先在那里注销。"
          }
        }
      }
    }
