    "Spectre isn't allowed to use the microphone. Turn it on in Settings › Privacy & Security › Microphone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre darf das Mikrofon nicht verwenden. Aktiviere es in Einstellungen › Datenschutz & Sicherheit › Mikrofon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre no tiene permiso para usar el micrófono. Actívalo en Ajustes › Privacidad y seguridad › Micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre n’est pas autorisé à utiliser le micro. Activez-le dans Réglages › Confidentialité et sécurité › Micro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre にはマイクの使用が許可されていません。「設定 › プライバシーとセキュリティ › マイク」でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre에 마이크 사용 권한이 없습니다. 설정 › 개인정보 보호 및 보안 › 마이크에서 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Spectre não tem permissão para usar o microfone. Ative-o em Ajustes › Privacidade e Segurança › Microfone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Spectre нет доступа к микрофону. Включите его в разделе Настройки › Конфиденциальность и безопасность › Микрофон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre 没有使用麦克风的权限。请在“设置 › 隐私与安全性 › 麦克风”里打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spectre 沒有使用麥克風的權限。請在「設定 › 隱私權與安全性 › 麥克風」裡開啟。"
          }
        }
      }
    },
